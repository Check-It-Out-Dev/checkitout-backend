# Docker Compose - Test Environment
# Generated by Ansible from deployment/test/docker-compose-test.yml
# Converted environment variables to Jinja2 template variables

services:
  # Init container that fetches secrets from Google Secrets Manager
  google-secrets-init:
    image: "{{ gsm_init_image_full | default('ghcr.io/check-it-out-dev/google-secrets-init:latest') }}"
    container_name: "{{ app_container_name | default('instagram-platform-test') }}-gsm-init"
    logging:
      driver: "journald"
      options:
        tag: "instagram-test-gsm-init"
        labels: "environment,service,version"
    user: "{{ container_user_id }}:{{ container_group_id }}"
    environment:
      # Core configuration
      - GCP_PROJECT_ID={{ gsm_project_id }}
      - GSM_INIT_DEBUG={{ gsm_init_debug | default('true') }}
      - ENVIRONMENT={{ environment }}
      - TARGET_USER={{ container_user_id }}
      - TARGET_GROUP={{ container_group_id }}
      # Secret prefix - used for stripping when writing
      - GSM_SECRET_PREFIX={{ gsm_secret_prefix }}
      # IMPORTANT: Strip prefix when writing for Spring Boot compatibility
      - STRIP_PREFIX_ON_WRITE=true
      # GCP Service Account key path
      - GCP_SA_KEY_PATH={{ gsm_service_account_path | dirname }}
      # CI/CD environment detection
      - CI={{ ci | default('false') }}
      - GITHUB_ACTIONS={{ github_actions | default('false') }}
      # Container identity
      - CONTAINER_USER_NAME={{ container_user_name }}
      - CONTAINER_GROUP_NAME={{ container_group_name }}
      - CONTAINER_USER_ID={{ container_user_id }}
      - CONTAINER_GROUP_ID={{ container_group_id }}
      # GCP CLI optimization
      - GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/service-account.json
      - XDG_CONFIG_HOME=/tmp
      - XDG_CACHE_HOME=/tmp
      - HOME=/tmp
      - CLOUDSDK_CORE_DISABLE_PROMPTS=1
      - GCLOUD_SILENCE_WARNINGS=1
      - CLOUDSDK_PYTHON_SITEPACKAGES=0
      # Timeout configuration
      - GSM_CLI_TIMEOUT={{ gsm_cli_timeout | default('60') }}
      - INIT_RETRY_COUNT={{ gsm_init_retry_count }}
      - INIT_RETRY_DELAY={{ gsm_init_retry_delay }}
      # Default values to prevent warnings
      - INIT_STATUS=
      - GSM_INIT_STATUS=
      - GSM_SECRET_COUNT=
    volumes:
      - secrets-storage:/app/config
      - backup-storage:/app/backup
      - "{{ test_secrets_path }}:/run/secrets:ro"
    working_dir: /app/config
    networks:
      - instagram-network
    restart: "no"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    read_only: true
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - SETUID
      - SETGID
    tmpfs:
      - /app/test-results
      - /tmp
      - /var/tmp
      - /app/logs
      - /app/.config
    deploy:
      resources:
        limits:
          cpus: '2'
          memory: 512M
        reservations:
          cpus: '2'
          memory: 512M

  # Redis Master for Rate Limiting and Caching
  redis:
    image: redis:7-alpine
    container_name: instagram-platform-test-redis
    hostname: redis-master
    command: redis-server --appendonly yes --maxmemory 256mb --maxmemory-policy allkeys-lru --bind 0.0.0.0 --protected-mode no
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "127.0.0.1:{{ port_test_redis }}:6379"
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD-SHELL", "redis-cli ping | grep PONG"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 10s
    restart: unless-stopped
    networks:
      instagram-network:
        ipv4_address: 172.20.0.10
        aliases:
          - redis-master
          - redis
    logging:
      driver: "journald"
      options:
        tag: "instagram-test-redis"
        labels: "environment,service,version"
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M
        reservations:
          cpus: '1'
          memory: 512M

  # Redis Sentinel for High Availability
  redis-sentinel:
    image: redis:7-alpine
    container_name: instagram-platform-test-redis-sentinel
    entrypoint: ["/sentinel-entrypoint.sh"]
    volumes:
      - ./sentinel-entrypoint.sh:/sentinel-entrypoint.sh:ro
    environment:
      - REDIS_HOST=172.20.0.10
      - REDIS_PORT=6379
      - SENTINEL_PORT=26379
      - MAX_TRIES=60
      - RETRY_DELAY=3
    ports:
      - "127.0.0.1:26379:26379"
    depends_on:
      redis:
        condition: service_healthy
    restart: unless-stopped
    networks:
      instagram-network:
        aliases:
          - sentinel
          - redis-sentinel
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -p 26379 ping | grep PONG"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 40s
    logging:
      driver: "journald"
      options:
        tag: "instagram-test-sentinel"
        labels: "environment,service,version"
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 256M
        reservations:
          cpus: '0.5'
          memory: 256M

  # PostgreSQL database service
  postgres:
    image: "{{ postgres_image }}"
    container_name: "instagram-platform-test-db"
    restart: unless-stopped
    depends_on:
      google-secrets-init:
        condition: service_completed_successfully
        restart: true
    entrypoint: ["/postgres-entrypoint.sh"]
    command: ["postgres"]
    environment:
      - PGDATA=/var/lib/postgresql/data/pgdata
      - POSTGRES_INITDB_ARGS=--encoding=UTF-8 --locale=en_US.UTF-8
    ports:
      - "127.0.0.1:{{ port_test_postgres }}:5432"
    volumes:
      - postgres-data:/var/lib/postgresql/data
      - secrets-storage:/app/config:ro,z
      - ./postgres-entrypoint.sh:/postgres-entrypoint.sh:ro,z
      - ./INIT_TEST_DATABASE.sql:/docker-entrypoint-initdb.d/INIT_TEST_DATABASE.sql:ro,z
    healthcheck:
      test: |
        CMD-SHELL
        if [ -f /app/config/secrets.env ]; then
          . /app/config/secrets.env;
          pg_isready -U $${POSTGRES_USER:-postgres} -h localhost -p 5432 &&
          psql -U $${POSTGRES_USER:-postgres} -h localhost -p 5432 -d $${DATABASE_NAME:-instagram_platform_test} -c 'SELECT 1' > /dev/null 2>&1 &&
          echo "Database ready";
        else
          echo "Secrets not ready";
          exit 1;
        fi
      interval: 5s
      timeout: 10s
      retries: 60
      start_period: 45s
    networks:
      - instagram-network
    logging:
      driver: "journald"
      options:
        tag: "instagram-test-postgres"
        labels: "environment,service,version"
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 812M
        reservations:
          cpus: '1'
          memory: 812M

  # Spring Boot Application
  app:
    image: "{{ main_app_image | default('ghcr.io/check-it-out-dev/checkitout-be/instagram-platform-backend-test:latest') }}"
    container_name: "{{ app_container_name | default('instagram-platform-test') }}-app"
    logging:
      driver: "journald"
      options:
        tag: "instagram-test-app"
        labels: "environment,service,version"
    user: "{{ container_user_id }}:{{ container_group_id }}"
    entrypoint: ["/app/spring-boot-entrypoint.sh"]
    ports:
      - "127.0.0.1:{{ server_port }}:{{ server_port }}"
    volumes:
      - secrets-storage:/app/config:ro,z
      - "{{ test_secrets_path }}:/run/secrets:ro"
      - "{{ base_log_path }}:/var/log/instagram-platform:rw"
      - ./spring-boot-entrypoint.sh:/app/spring-boot-entrypoint.sh:ro
    environment:
      - SPRING_PROFILES_ACTIVE={{ spring_profile }}
      - DATABASE_HOST={{ spring_datasource_host }}
      - DATABASE_PORT={{ spring_datasource_port }}
      - GCP_SA_KEY_PATH={{ test_secrets_path }}
      - GCP_CREDS_CONTAINER_PATH=/run/secrets
      - JAVA_OPTS={{ java_opts | default('-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0 -Xmx2g -Xms1g -XX:MaxMetaspaceSize=256m -Djava.security.egd=file:/dev/./urandom') }}
      - SERVER_PORT={{ server_port }}
      - MANAGEMENT_SERVER_PORT={{ server_port }}
      - SECRETS_MOUNT_PATH=/app/config
      - SECRETS_DEVELOPMENT_MODE=false
    depends_on:
      google-secrets-init:
        condition: service_completed_successfully
      postgres:
        condition: service_healthy
        restart: true
      redis:
        condition: service_healthy
      redis-sentinel:
        condition: service_healthy
    networks:
      - instagram-network
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://localhost:{{ server_port }}/api/actuator/health || exit 1"]
      interval: 60s
      timeout: 30s
      retries: 20
      start_period: 180s
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    deploy:
      resources:
        limits:
          cpus: '2'
          memory: 4096M
        reservations:
          cpus: '1'
          memory: 3072M

volumes:
  secrets-storage:
    driver: local
    name: "{{ docker_volume_secrets }}"
    labels:
      - "com.instagram.volume.type=secrets"
      - "com.instagram.volume.lifecycle=ephemeral"
      - "com.instagram.volume.owner={{ container_user_id }}"
      - "com.instagram.volume.group={{ container_group_id }}"

  backup-storage:
    driver: local
    name: "{{ docker_volume_backup }}"
    labels:
      - "com.instagram.volume.type=backup"
      - "com.instagram.volume.lifecycle=ephemeral"

  postgres-data:
    driver: local
    name: "{{ docker_volume_postgres }}"
    labels:
      - "com.instagram.volume.type=database"
      - "com.instagram.volume.lifecycle=persistent"
      - "com.instagram.volume.backup=required"
      - "com.instagram.volume.preserve=true"
      - "com.instagram.volume.description=PostgreSQL database - DO NOT DELETE"

  redis-data:
    driver: local
    name: "{{ docker_volume_redis }}"
    labels:
      - "com.instagram.volume.type=cache"
      - "com.instagram.volume.lifecycle=persistent"
      - "com.instagram.volume.backup=optional"
      - "com.instagram.volume.description=Redis cache with HA"

networks:
  instagram-network:
    driver: bridge
    name: "{{ docker_network_name }}"
    internal: false
    ipam:
      driver: default
      config:
        - subnet: {{ docker_network_subnet }}
          gateway: {{ docker_network_gateway }}
    driver_opts:
      com.docker.network.bridge.enable_icc: "true"
      com.docker.network.bridge.enable_ip_masquerade: "true"
      com.docker.network.driver.mtu: "1500"
    labels:
      - "com.instagram.network.type=test"
      - "com.instagram.network.purpose=init-container-testing"
      - "com.instagram.network.created={{ ansible_date_time.iso8601 }}"
