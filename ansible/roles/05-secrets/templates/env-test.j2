# Test Environment Variables
# Generated by Ansible - DO NOT EDIT MANUALLY
# Instagram Platform Test Environment

# Environment
ENVIRONMENT={{ environment }}
SPRING_PROFILES_ACTIVE={{ spring_profile }}

# Server Configuration
SERVER_PORT={{ server_port }}
SERVER_SERVLET_CONTEXT_PATH={{ server_context_path }}

# Database Configuration (Containerized PostgreSQL)
SPRING_DATASOURCE_HOST={{ spring_datasource_host }}
SPRING_DATASOURCE_PORT={{ spring_datasource_port }}
SPRING_DATASOURCE_DATABASE={{ spring_datasource_database }}
{% if vault_test_database_username is defined %}
SPRING_DATASOURCE_USERNAME={{ vault_test_database_username }}
{% endif %}
{% if vault_test_database_password is defined %}
SPRING_DATASOURCE_PASSWORD={{ vault_test_database_password }}
{% endif %}

# Google Secret Manager
GSM_PROJECT_ID={{ gsm_project_id }}
GSM_SECRET_PREFIX={{ gsm_secret_prefix }}
GSM_SECRETS_PATH={{ gsm_secrets_path }}
GOOGLE_APPLICATION_CREDENTIALS={{ gsm_service_account_path }}

# Security
{% if vault_test_jwt_secret is defined %}
JWT_SECRET={{ vault_test_jwt_secret }}
{% endif %}
{% if vault_test_encryption_key is defined %}
ENCRYPTION_KEY={{ vault_test_encryption_key }}
{% endif %}

# Logging
LOG_LEVEL={{ log_level }}
LOG_BASE_PATH={{ base_log_path }}/test

# Application URLs
BACKEND_URL={{ test_backend_url }}
FRONTEND_URL={{ test_frontend_url }}
