# SSH hardening configuration for Instagram Platform VPS
# Generated by Ansible - DO NOT EDIT MANUALLY
# This file is included in /etc/ssh/sshd_config.d/

# Disable root login
PermitRootLogin {{ sshd_config.PermitRootLogin }}

# Only allow public key authentication
PubkeyAuthentication {{ sshd_config.PubkeyAuthentication }}
PasswordAuthentication {{ sshd_config.PasswordAuthentication }}
ChallengeResponseAuthentication {{ sshd_config.ChallengeResponseAuthentication }}
PermitEmptyPasswords {{ sshd_config.PermitEmptyPasswords }}
UsePAM yes

# Disable X11 forwarding
X11Forwarding {{ sshd_config.X11Forwarding }}

# Disable agent forwarding
AllowAgentForwarding {{ sshd_config.AllowAgentForwarding }}

# TCP forwarding
AllowTcpForwarding {{ sshd_config.AllowTcpForwarding }}

# Gateway ports
GatewayPorts {{ sshd_config.GatewayPorts }}

# Use only strong ciphers
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr

# Use only strong MACs
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256

# Use only strong key exchange algorithms
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group-exchange-sha256

# Maximum authentication attempts
MaxAuthTries {{ sshd_config.MaxAuthTries }}

# Maximum sessions per connection
MaxSessions {{ sshd_config.MaxSessions }}

# Client alive interval (disconnect idle clients)
ClientAliveInterval {{ sshd_config.ClientAliveInterval }}
ClientAliveCountMax {{ sshd_config.ClientAliveCountMax }}

# Login grace time
LoginGraceTime {{ sshd_config.LoginGraceTime }}

# Log level
LogLevel {{ sshd_config.LogLevel }}

# Restrict SSH access to specific users only
AllowUsers ubuntu ovh instagram-scripts-admin instagram-test-deploy instagram-prod-deploy

# Per-user SSH settings
Match User instagram-scripts-admin
    ClientAliveInterval 30
    ClientAliveCountMax 240
    MaxSessions 5
    PasswordAuthentication no
    PubkeyAuthentication yes

Match User ovh
    AuthenticationMethods publickey
    PubkeyAuthOptions verify-required
    PubkeyAcceptedAlgorithms sk-ssh-ed25519@openssh.com,sk-ecdsa-sha2-nistp256@openssh.com,ssh-ed25519,ssh-rsa,ecdsa-sha2-nistp256
