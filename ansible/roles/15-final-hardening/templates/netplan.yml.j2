# Netplan configuration for Instagram Platform VPS
# Generated by Ansible - DO NOT EDIT MANUALLY

network:
  version: 2
  renderer: networkd
  ethernets:
    {{ vps_interface_name }}:
      # IPv4 configuration
      addresses:
        - {{ vps_ipv4 }}/32
      routes:
        - to: default
          via: {{ vps_gateway_ipv4 }}
          on-link: true
      # IPv6 configuration
      addresses:
        - {{ vps_ipv6 }}/128
      routes:
        - to: default
          via: {{ vps_gateway_ipv6 }}
          on-link: true
      # DNS servers
      nameservers:
        addresses:
{% for dns in dns_servers %}
          - {{ dns }}
{% endfor %}
{% for dns in dns_servers_ipv6 %}
          - {{ dns }}
{% endfor %}
