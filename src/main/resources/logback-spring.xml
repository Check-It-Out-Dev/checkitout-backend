<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">
    <!-- Suppress Logback's internal status messages -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />
    
    <!-- Spring Boot logging properties -->
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="target/var/log"/>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="instagram-platform"/>
    
    <!-- Define log directory based on environment -->
    <property name="LOG_DIR" value="${LOG_PATH}"/>
    
    <!-- Console appender - used by all environments -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{REQUEST_ID:-NO-REQ}] [%X{correlationId:-NO-TRACE}] [%X{requestMethod:-}:%X{requestUri:-}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- Profile-specific file appenders -->
    <springProfile name="dev,local">
        <!-- UNIFIED DEV/LOCAL APPENDER - All logs in one file for development -->
        <appender name="UNIFIED_DEV_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/${APP_NAME}-dev-unified.log</file>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{REQUEST_ID:-NO-REQ}] [%X{correlationId:-NO-TRACE}] [%X{requestMethod:-}:%X{requestUri:-}] %logger{50} - %msg%n</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/${APP_NAME}-dev-unified.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>20MB</maxFileSize>
                <maxHistory>3</maxHistory>
                <totalSizeCap>100MB</totalSizeCap>
            </rollingPolicy>
        </appender>
    </springProfile>
    
    <springProfile name="tst">
        <!-- UNIFIED TEST APPENDER - All logs in one file for test environment -->
        <appender name="UNIFIED_TEST_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/${APP_NAME}-test-unified.log</file>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{REQUEST_ID:-NO-REQ}] [%X{correlationId:-NO-TRACE}] [%X{requestMethod:-}:%X{requestUri:-}] %logger{50} - %msg%n</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/${APP_NAME}-test-unified.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <maxHistory>7</maxHistory>
                <totalSizeCap>500MB</totalSizeCap>
            </rollingPolicy>
        </appender>
    </springProfile>
    
    <springProfile name="prod">
        <!-- UNIFIED PRODUCTION APPENDER - All logs in one file for production environment -->
        <appender name="UNIFIED_PROD_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/${APP_NAME}-prod-unified.log</file>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{REQUEST_ID:-NO-REQ}] [%X{correlationId:-NO-TRACE}] [%X{requestMethod:-}:%X{requestUri:-}] %logger{50} - %msg%n</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/${APP_NAME}-prod-unified.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>100MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>2GB</totalSizeCap>
            </rollingPolicy>
        </appender>
    </springProfile>
    
    <!-- Application-specific loggers for dev/local profile -->
    <springProfile name="dev,local">
        <logger name="com.sm.instagram.platform" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_DEV_FILE"/>
        </logger>
        
        <!-- Upload system specific logging -->
        <logger name="com.sm.instagram.platform.storage" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_DEV_FILE"/>
        </logger>
        
        <logger name="com.sm.instagram.platform.storage.controller.WebhookController" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_DEV_FILE"/>
        </logger>
        
        <logger name="com.sm.instagram.platform.storage.service.FileTrackingService" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_DEV_FILE"/>
        </logger>
        
        <logger name="org.springframework" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_DEV_FILE"/>
        </logger>
        
        <logger name="org.hibernate" level="WARN" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_DEV_FILE"/>
        </logger>
        
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_DEV_FILE"/>
        </root>
    </springProfile>
    
    <!-- Application-specific loggers for test profile -->
    <springProfile name="tst">
        <logger name="com.sm.instagram.platform" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_TEST_FILE"/>
        </logger>
        
        <logger name="org.springframework" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_TEST_FILE"/>
        </logger>
        
        <logger name="org.hibernate" level="WARN" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_TEST_FILE"/>
        </logger>
        
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_TEST_FILE"/>
        </root>
    </springProfile>
    
    <!-- Application-specific loggers for production profile -->
    <springProfile name="prod">
        <!-- Main application at WARN level -->
        <logger name="com.sm.instagram.platform" level="WARN" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_PROD_FILE"/>
        </logger>
        
        <!-- Startup validators always at INFO level for visibility -->
        <logger name="com.sm.instagram.platform.common.validator" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_PROD_FILE"/>
        </logger>
        
        <logger name="com.sm.instagram.platform.auth.validator" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_PROD_FILE"/>
        </logger>
        
        <logger name="com.sm.instagram.platform.common.security.MaxMindStartupValidator" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_PROD_FILE"/>
        </logger>
        
        <logger name="com.sm.instagram.platform.auth.social.instagram.InstagramStartupValidator" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_PROD_FILE"/>
        </logger>
        
        <logger name="com.sm.instagram.platform.common.credentials" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_PROD_FILE"/>
        </logger>
        
        <logger name="com.sm.instagram.platform.secrets" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_PROD_FILE"/>
        </logger>
        
        <logger name="org.springframework" level="WARN" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_PROD_FILE"/>
        </logger>
        
        <logger name="org.hibernate" level="ERROR" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_PROD_FILE"/>
        </logger>
        
        <!-- Production root logger -->
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="UNIFIED_PROD_FILE"/>
        </root>
    </springProfile>
    
    <!-- DEFAULT CONFIGURATION for when no specific profile is active -->
    <springProfile name="!dev &amp; !local &amp; !tst &amp; !prod">
        <logger name="com.sm.instagram.platform" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
        
        <logger name="org.springframework" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
        
        <logger name="org.hibernate" level="WARN" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
        
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
    
</configuration>