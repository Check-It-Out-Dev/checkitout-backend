# =============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# Copy to .env and fill in real values. Never commit .env to git.
# =============================================================================

# --- Instagram / Meta ---
INSTAGRAM_TEST_TOKEN=your-token-here                 # 60-day token from Meta Graph API Explorer
META_APP_ID=your-meta-app-id                           # Meta App ID (TEST - constant)
META_APP_SECRET=your-meta-app-secret                  # Meta App Secret (from Meta Developer Console)
INSTAGRAM_CLIENT_ID=your-instagram-app-id                  # Instagram App ID (TEST - constant)
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret  # Instagram App Secret

# --- MaxMind GeoIP ---
MAXMIND_LICENSE_KEY=your-maxmind-license-key          # For GeoIP database downloads

# --- JWT & Cookie Security ---
JWT_SECRET=your-jwt-secret-min-256-bits               # Backend JWT signing key (HS256)
COOKIE_HMAC_SECRET=your-cookie-hmac-secret-min-256-bits  # Session cookie HMAC signature
CONSENT_HMAC_SECRET=your-consent-hmac-secret-min-256-bits  # Legal consent cookie HMAC

# --- Admin ---
ADMIN_FIREBASE_UID=your-admin-firebase-uid            # Firebase UID of the admin user
ADMIN_EMAIL=admin@example.com                         # Admin email address

# --- Email (Gmail App Password) ---
MAIL_PASSWORD=your-gmail-app-password                 # Gmail SMTP app password (not account password)

# --- Polish Public Registry APIs ---
GUS_BIR1_API_KEY=your-gus-api-key                     # GUS BIR 1.1 (request from regon_bir@stat.gov.pl)
CEIDG_APP_KEY=your-ceidg-jwt-token                    # CEIDG API (obtain from biznes.gov.pl via Profil Zaufany)

# --- Fakturownia (Polish Invoicing) ---
FAKTUROWNIA_API_KEY=your-fakturownia-api-key          # API token from fakturownia.pl
FAKTUROWNIA_DOC_KEY=your-fakturownia-doc-key          # Document access key

# --- Stripe (Test Mode) ---
STRIPE_PUBLIC_KEY=pk_test_your-public-key             # From dashboard.stripe.com -> API Keys
STRIPE_PRIVATE_KEY=sk_test_your-secret-key            # From dashboard.stripe.com -> API Keys
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret       # From Stripe CLI or Dashboard -> Webhooks
APP_BASE_URL=https://localhost:4200                    # Stripe redirect URL after checkout

# --- Firebase ---
FIREBASE_SERVICE_ACCOUNT_JSON=your-base64-encoded-json  # base64 -w 0 service-account.json
