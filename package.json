{
  "name": "instagram-platform-firebase",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Firebase Storage rules and configuration for Instagram Platform",
  "scripts": {
    "test:storage-rules": "jest src/test/javascript/storage-rules.test.js",
    "deploy:storage-rules:test": "./scripts/deploy-storage-rules.sh test",
    "deploy:storage-rules:prod": "./scripts/deploy-storage-rules.sh production",
    "firebase:emulator": "firebase emulators:start --only storage"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.30.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/src/test/javascript/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "overrides": {
    "qs@6": "6.16.0",
    "csv-parse@5": "7.0.2",
    "@opentelemetry/core@1": "2.8.0",
    "uuid@9": "11.1.1"
  }
}
