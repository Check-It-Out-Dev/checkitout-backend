# File: sudo visudo -f /etc/sudoers.d/instagram-scripts-admin
# Defaults for instagram-scripts-admin user
Defaults:instagram-scripts-admin !requiretty
Defaults:instagram-scripts-admin setenv
Defaults:instagram-scripts-admin !mail_always
Defaults:instagram-scripts-admin !mail_badpass
Defaults:instagram-scripts-admin !mail_no_user

# NEW: Prevent PAM session timeout
Defaults:instagram-scripts-admin !pam_session
Defaults:instagram-scripts-admin !use_pty
Defaults:instagram-scripts-admin !pam_setcred

# FIXED: Preserve critical environment variables through sudo
Defaults:instagram-scripts-admin env_keep += "ENV_FILE_PATH PWD HOME ENVIRONMENT DEPLOYMENT_PATH BACKUP_BASE_PATH RETENTION_COUNT GITHUB_RUN_ID TIMESTAMP SCRIPT_EXECUTION_TIMEOUT_SECONDS SYSTEMD_SERVICE HCP_APP_NAME RUNTIME_PATH REMOTE_SCRIPT_PATH HEALTH_CHECK_TIMEOUT HCP_SECRET_PREFIX CICD_LOG_BASE CICD_LOG_FILE CICD_LOG_PATH CICD_OPERATION CICD_TIMESTAMP CONTAINER_GROUP_NAME CONTAINER_USER_NAME ADMIN_BASE ADMIN_PACKAGE_PATH IMAGE_TAG HCP_INIT_IMAGE_FULL OUTPUT_FILE CICD_LOG_ENABLED CICD_LOG_GROUP GITHUB_RUN_NUMBER SERVICE_START_TIMEOUT SERVICE_STOP_TIMEOUT VALIDATION_TIMEOUT SHA256_CHECKSUM ADMIN_HOME"

# Preserve CI/CD build environment variables
Defaults:instagram-scripts-admin env_keep += "DOCKER_BUILDKIT JAVA_HOME MAVEN_OPTS GITHUB_* RUNNER_* CI ACTIONS_*"

# Additional security settings
Defaults:instagram-scripts-admin syslog=auth
Defaults:instagram-scripts-admin log_input, log_output

