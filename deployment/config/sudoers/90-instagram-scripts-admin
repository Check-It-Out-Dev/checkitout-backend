    /var/lib/instagram-scripts-admin/validate-and-exec-ci-script-[0-9]*.sh /var/lib/instagram-scripts-admin/reload-and-validate-[0-9]*.sh [a-zA-Z0-9]*, \
    /var/lib/instagram-scripts-admin/validate-and-exec-ci-script-[0-9]*.sh /var/lib/instagram-scripts-admin/backup-pre-deploy-[0-9]*.sh [a-zA-Z0-9]*

# File operations for CI/CD scripts (consolidated pattern-based)
instagram-scripts-admin ALL=(root) NOPASSWD: \
    /usr/bin/chmod +x /var/lib/instagram-scripts-admin/*-[0-9]*.sh, \
    /usr/bin/chmod 750 /var/lib/instagram-scripts-admin/*-[0-9]*.sh, \
    /usr/bin/chmod 640 /var/lib/instagram-scripts-admin/*-[0-9]*.sh.metadata, \
    /usr/bin/chown instagram-scripts-admin\:instagram-scripts-admin /var/lib/instagram-scripts-admin/*-[0-9]*.sh, \
    /usr/bin/chown instagram-scripts-admin\:instagram-scripts-admin /var/lib/instagram-scripts-admin/*-[0-9]*.sh.metadata

# Cleanup operations for CI/CD scripts (covered by pattern-based rules above)

# Immutability operations for reload and backup scripts
instagram-scripts-admin ALL=(root) NOPASSWD: \
    /usr/bin/chattr +i /var/lib/instagram-scripts-admin/reload-and-validate-[0-9]*.sh, \
    /usr/bin/chattr +i /var/lib/instagram-scripts-admin/reload-and-validate-[0-9]*.sh.metadata, \
    /usr/bin/chattr +i /var/lib/instagram-scripts-admin/backup-pre-deploy-[0-9]*.sh, \
    /usr/bin/chattr +i /var/lib/instagram-scripts-admin/backup-pre-deploy-[0-9]*.sh.metadata, \
    /usr/bin/chattr -i /var/lib/instagram-scripts-admin/reload-and-validate-[0-9]*.sh, \
    /usr/bin/chattr -i /var/lib/instagram-scripts-admin/reload-and-validate-[0-9]*.sh.metadata, \
    /usr/bin/chattr -i /var/lib/instagram-scripts-admin/backup-pre-deploy-[0-9]*.sh, \
    /usr/bin/chattr -i /var/lib/instagram-scripts-admin/backup-pre-deploy-[0-9]*.sh.metadata

# ================================================================================
# GITHUB RUNNER WORKSPACE OPERATIONS
# ================================================================================

# Maven operations in runner workspace
instagram-scripts-admin ALL=(root) NOPASSWD: \
    /usr/bin/mvn -f /home/ubuntu/actions-runner/_work/*/pom.xml *, \
    /usr/bin/mvn -f /home/ubuntu/actions-runner/_work/*/*/pom.xml *

# GitHub runner workspace cleanup
instagram-scripts-admin ALL=(root) NOPASSWD: \
    /usr/bin/rm -rf /home/ubuntu/actions-runner/_work/*, \
    /usr/bin/rm -rf /home/ubuntu/actions-runner/_temp/*

# ================================================================================
# YAML/FILE VALIDATION OPERATIONS - REMOVED
# ================================================================================
# NOTE: YAML validation is done internally in deploy-and-secure.sh
# yamllint, cat, and sed are NOT used by the CI/CD pipeline


# ================================================================================
# SECURITY RESTRICTIONS
# ================================================================================

# Block package managers
Cmnd_Alias PACKAGE_MANAGERS_ADMIN = /usr/bin/apt, /usr/bin/apt-get, \
                              /usr/sbin/dpkg, /usr/bin/snap, \
                              /usr/bin/pip, /usr/bin/pip3, \
                              /usr/bin/npm, /usr/bin/yarn

instagram-scripts-admin ALL = (ALL) !PACKAGE_MANAGERS_ADMIN

# Block dangerous editors and interpreters
Cmnd_Alias DANGEROUS_TOOLS_ADMIN = /usr/bin/vi, /usr/bin/vim, /usr/bin/nano, \
                             /usr/bin/emacs, /usr/bin/ed, \
                             /usr/bin/perl, /usr/bin/ruby, \
                             /usr/bin/php*, /usr/bin/zsh

instagram-scripts-admin ALL = (ALL) !DANGEROUS_TOOLS_ADMIN

# Block script execution from unsafe locations
Cmnd_Alias UNSAFE_LOCATIONS_ADMIN = /tmp/*, /var/tmp/*, /dev/shm/*, \
                              /home/*/Downloads/*, /home/*/.local/*, \
                              /home/*/.cache/*, /run/user/*

instagram-scripts-admin ALL = (ALL) !UNSAFE_LOCATIONS_ADMIN