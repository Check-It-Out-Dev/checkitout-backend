# Instagram Scripts Admin Secure Sudoers Configuration
# For immutability implementation with chattr

# Allow instagram-scripts-admin to use chattr for immutability
instagram-scripts-admin ALL=(root) NOPASSWD: /usr/bin/chattr

# Consolidated log management rules are in the main section below

# Existing permissions (keep these)
instagram-scripts-admin ALL=(instagram-test-deploy) NOPASSWD: ALL
instagram-scripts-admin ALL=(root) NOPASSWD: /usr/bin/su - instagram-deploy-admin -c *
# Allow rm operations for cleanup (consolidated)
instagram-scripts-admin ALL=(root) NOPASSWD: \
    /usr/bin/rm -rf /var/lib/instagram-scripts-admin/*, \
    /usr/bin/rm -rf /var/lib/instagram-scripts-admin/.*, \
    /usr/bin/rm -rf /var/lib/instagram-scripts-admin/..?*, \
    /usr/bin/rm -rf /var/lib/instagram-scripts-admin/.[!.]*

# Allow chmod/chown for secure-logger.sh (consolidated)
instagram-scripts-admin ALL=(root) NOPASSWD: \
    /usr/bin/chmod 750 /var/lib/instagram-scripts-admin/secure-logger.sh, \
    /usr/bin/chmod 640 /var/lib/instagram-scripts-admin/secure-logger.sh.metadata, \
    /usr/bin/chown instagram-scripts-admin\:instagram-scripts-admin /var/lib/instagram-scripts-admin/secure-logger.sh*

# Allow execution wrapper scripts in /tmp (with specific pattern for security)
instagram-scripts-admin ALL=(root) NOPASSWD: \
    /bin/chmod +x /tmp/deploy_exec_[0-9]*.sh, \
    /tmp/deploy_exec_[0-9]*.sh, \
    /bin/rm -f /tmp/deploy_exec_[0-9]*.sh

# Allow creation and management of CI/CD log directories (using mkdir -p pattern)
instagram-scripts-admin ALL=(root) NOPASSWD: \
    /usr/bin/mkdir -p /var/log/CiCd*, \
    /usr/bin/chmod 755 /var/log/CiCd*, \
    /usr/bin/chown instagram-scripts-admin\:instagram-cicd /var/log/CiCd*

# Allow creation and management of CI/CD log files
instagram-scripts-admin ALL=(root) NOPASSWD: \
    /usr/bin/touch /var/log/CiCd/*/*, \
    /usr/bin/chmod 640 /var/log/CiCd/*/cicd-*.log, \
    /usr/bin/chown instagram-scripts-admin\:instagram-cicd /var/log/CiCd/*/cicd-*.log, \
    /usr/bin/chattr +a /var/log/CiCd/*/cicd-*.log, \
    /usr/bin/chattr -a /var/log/CiCd/*/cicd-*.log

# Allow tee for writing to log files (already covered by general pattern above)
# Using the general pattern from log setup section instead

# Allow tail for reading log files
instagram-scripts-admin ALL=(root) NOPASSWD: \
    /usr/bin/tail -* /var/log/CiCd/*/*.log, \
    /usr/bin/tail /var/log/CiCd/*/*.log

